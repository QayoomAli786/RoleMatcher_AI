{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "functions": {
    "main.py": {
      "maxDuration": 60,
      "includeFiles": "frontend/**",
      "excludeFiles": "{backend/tests/**,**/__pycache__/**,data/**,output/**,.venv/**,venv/**,*.db,*.db-shm,*.db-wal}"
    }
  }
}
