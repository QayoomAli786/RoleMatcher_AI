# ── Database ──────────────────────────────────────────────
# Option 1: SQLite (no install needed, for local dev)
CC_POSTGRES_URL=sqlite+aiosqlite:///./careercopilot.db
CC_POSTGRES_URL_SYNC=sqlite:///./careercopilot.db

# Option 2: PostgreSQL / Supabase
# Get your connection string from:
#   Supabase Dashboard > Project > Connect (green button at top)
#   Or: Settings > Database > Connection string
#
# IMPORTANT: Use the POOLER connection (port 6543), NOT the direct one.
# The pooler format is: postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
#
# Replace <PROJECT_REF> and <PASSWORD> with your actual values.
# URL-encode special chars in password: @ -> %40, # -> %23, etc.

# CC_POSTGRES_URL=postgresql+asyncpg://postgres.<PROJECT_REF>:<PASSWORD>%40@aws-0-<REGION>.pooler.supabase.com:6543/postgres
# CC_POSTGRES_URL_SYNC=postgresql://postgres.<PROJECT_REF>:<PASSWORD>%40@aws-0-<REGION>.pooler.supabase.com:6543/postgres

# ── Redis (optional — leave empty for in-memory only) ────
CC_REDIS_URL=

# ── Auth ─────────────────────────────────────────────────
CC_JWT_SECRET=change-me-in-production

# ── LLM providers ───────────────────────────────────────
CC_LLM_PROVIDER=gemini
CC_FAST_MODEL=gemini/gemini-2.5-flash-lite
CC_STRONG_MODEL=gemini/gemini-2.5-flash
CC_EMBEDDING_MODEL=text-embedding-004

# ── API keys ─────────────────────────────────────────────
CC_GEMINI_API_KEY=
CC_GROQ_API_KEY=
CC_OPENAI_API_KEY=
CC_DEEPSEEK_API_KEY=
CC_QWEN_API_KEY=
CC_QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ── App settings ─────────────────────────────────────────
CC_DEBUG=false
CC_ENVIRONMENT=development
