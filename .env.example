# RoleMatcher AI — environment variable template
#
# Copy to .env for local development:
#   cp .env.example .env
# Then fill in the values. For Vercel, add these as Project Environment
# Variables (or import a filled-in .env file in the Vercel dashboard).
# Never commit real secrets.

# ── Database: Neon Postgres ─────────────────────────────────────────────────
# Use the POOLED connection string (hostname contains "-pooler"), e.g.:
# postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# ── LLM provider keys (optional) ───────────────────────────────────────────
CC_GEMINI_API_KEY=
CC_GROQ_API_KEY=
CC_OPENAI_API_KEY=
CC_DEEPSEEK_API_KEY=
CC_QWEN_API_KEY=

# ── Model routing ──────────────────────────────────────────────────────────
CC_FAST_MODEL=gemini/gemini-2.5-flash-lite
CC_STRONG_MODEL=gemini/gemini-2.5-flash
CC_LLM_TEMPERATURE=0.3
CC_LLM_MAX_TOKENS=4096

# ── Application / rate limiting ────────────────────────────────────────────
CC_DEBUG=false
CC_RATE_LIMIT_REQUESTS=60
CC_RATE_LIMIT_WINDOW_SECONDS=60
CC_REDIS_URL=

# ── File uploads ───────────────────────────────────────────────────────────
CC_MAX_UPLOAD_SIZE_MB=10
CC_ALLOWED_UPLOAD_EXTENSIONS=[".pdf",".docx",".txt"]

# ── Email (OTP codes; without these, codes are printed to the logs) ────────
CC_SMTP_HOST=
CC_SMTP_PORT=465
CC_SMTP_USER=
CC_SMTP_PASSWORD=
CC_SMTP_FROM_EMAIL=
CC_SMTP_FROM_NAME=RoleMatcherAI
CC_SMTP_USE_TLS=true

# ── Job source APIs (optional) ─────────────────────────────────────────────
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
